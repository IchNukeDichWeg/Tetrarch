.venv/
.claude/
build/
__pycache__/
*.pyc
*.so
*.dylib

# Run logs: mostly progress-bar redraws, and the result they describe is
# already in docs/AB.md. Kept on disk, out of the tree.
*.log

# runs/ holds what a campaign produced: runs/games (self-play), runs/ab (match
# logs), runs/logs (stdout). All of it is matched by the rules below and stays
# untracked -- a single games file is over GitHub's 100 MB limit, and large
# blobs stay in git history permanently even after deletion. The nets those
# runs produced ARE tracked, under nets/*.nnue, because an A/B number is only
# reproducible if the net that produced it is in the tree.

# Generated data: training positions, nets, match logs, campaign state.
# Every tool writes to a path given on the CLI; these are the conventional
# scratch locations, never a default.
scratch/
*.bin
*.nnue
*.jsonl
# Nets are the exception: a net is small, and an A/B result is only
# reproducible if the net that produced it is in the tree. Nested output
# directories (train.py --out nets/v2/) stay ignored -- promote the one net
# that matters to nets/net-vN.nnue rather than committing every epoch.
!nets/*.nnue
*.pgn4
tetrarch-v*.tar.gz

# Bulk artefacts pulled off a generation host. Regenerable, and far too large
# for the repo.
tetrarch_export/

.DS_Store

# Third-party bundle used only as a local sparring partner. Never committed.
variants.js
test_engine
test_engine2

# Generated opening books: rebuildable from book.py, and large.
book*.txt
